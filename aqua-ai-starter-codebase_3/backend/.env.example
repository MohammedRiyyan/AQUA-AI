ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-string

DATABASE_URL=postgresql+asyncpg://aqua:aqua@postgres:5432/aqua_ai
REDIS_URL=redis://redis:6379/0

VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=aqua_hydration_knowledge

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL_PATH=models/aqua-hydration-llm
GENERATION_MODEL_FALLBACK=Qwen/Qwen2.5-0.5B-Instruct

ALLOWED_ORIGINS=["http://localhost:3000"]
